# The build test compares hub.html with a fresh build of hub.src.html byte for byte (after
# normalising line endings), so text files keep LF in every checkout, whatever core.autocrlf says.
*.html text eol=lf
*.js text eol=lf
*.py text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.png binary
